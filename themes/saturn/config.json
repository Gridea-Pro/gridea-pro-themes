{
  "name": "Saturn",
  "version": "1.0.0",
  "author": "seolcho0827",
  "description": "卡片模块化设计的博客主题 · 圆角卡片嵌套、环状装饰元素、灵动布局",
  "engine": "jinja2",
  "templateEngine": "jinja2",
  "customConfig": [
    {
      "name": "accentColor",
      "label": "强调色",
      "group": "外观设置",
      "type": "input",
      "value": "#9b59b6",
      "note": "链接、按钮等元素的强调颜色"
    },
    {
      "name": "showDarkModeToggle",
      "label": "显示暗色模式切换",
      "group": "外观设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "showSearch",
      "label": "侧边栏显示搜索",
      "group": "功能设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "showCalendar",
      "label": "侧边栏显示日历",
      "group": "功能设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "layout",
      "label": "页面布局",
      "group": "布局设置",
      "type": "select",
      "value": "right-sidebar",
      "options": [
        { "label": "右侧侧边栏", "value": "right-sidebar" },
        { "label": "全宽无侧边栏", "value": "full-width" }
      ]
    },
    {
      "name": "showSidebar",
      "label": "显示侧边栏",
      "group": "布局设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "postsPerPage",
      "label": "每页文章数",
      "group": "文章设置",
      "type": "input",
      "value": "10"
    },
    {
      "name": "showTagsInPost",
      "label": "文章底部显示标签",
      "group": "文章设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "showPostNav",
      "label": "显示上下篇导航",
      "group": "文章设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "socialGithub",
      "label": "GitHub 用户名",
      "group": "社交设置",
      "type": "input",
      "value": ""
    },
    {
      "name": "socialTwitter",
      "label": "Twitter 用户名",
      "group": "社交设置",
      "type": "input",
      "value": ""
    },
    {
      "name": "footerText",
      "label": "页脚自定义文字",
      "group": "基础设置",
      "type": "input",
      "value": ""
    },
    {
      "name": "customCSS",
      "label": "自定义 CSS",
      "group": "高级设置",
      "type": "textarea",
      "value": ""
    }
  ]
}
