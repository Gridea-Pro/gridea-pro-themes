{
  "name": "Mars",
  "version": "1.0.0",
  "author": "seolcho0827",
  "description": "硬核暗色优先的技术博客主题 · 默认暗色模式、等宽字体点缀、开发者风格",
  "templateEngine": "jinja2",
  "customConfig": [
    {
      "name": "accentColor",
      "label": "强调色",
      "group": "外观设置",
      "type": "input",
      "value": "#e94560",
      "note": "链接、代码高亮等元素的强调颜色"
    },
    {
      "name": "defaultTheme",
      "label": "默认主题模式",
      "group": "外观设置",
      "type": "select",
      "value": "dark",
      "options": [
        { "label": "深色（默认）", "value": "dark" },
        { "label": "浅色", "value": "light" }
      ]
    },
    {
      "name": "showDarkModeToggle",
      "label": "显示暗色模式切换",
      "group": "外观设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "showSearch",
      "label": "显示终端搜索框",
      "group": "功能设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "sidebarPosition",
      "label": "侧边栏位置",
      "group": "布局设置",
      "type": "select",
      "value": "left",
      "options": [
        { "label": "左侧", "value": "left" },
        { "label": "右侧", "value": "right" }
      ]
    },
    {
      "name": "showSidebar",
      "label": "显示侧边栏",
      "group": "布局设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "postsPerPage",
      "label": "每页文章数",
      "group": "文章设置",
      "type": "input",
      "value": "10"
    },
    {
      "name": "showTagsInPost",
      "label": "文章底部显示标签",
      "group": "文章设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "showPostNav",
      "label": "显示上下篇导航",
      "group": "文章设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "socialGithub",
      "label": "GitHub 用户名",
      "group": "社交设置",
      "type": "input",
      "value": ""
    },
    {
      "name": "socialTwitter",
      "label": "Twitter 用户名",
      "group": "社交设置",
      "type": "input",
      "value": ""
    },
    {
      "name": "footerText",
      "label": "页脚自定义文字",
      "group": "基础设置",
      "type": "input",
      "value": ""
    },
    {
      "name": "customCSS",
      "label": "自定义 CSS",
      "group": "高级设置",
      "type": "textarea",
      "value": ""
    }
  ]
}
