{
  "name": "Uranus",
  "version": "1.0.0",
  "author": "seolcho0827",
  "description": "打破常规的实验性博客主题 · 非对称布局、大胆留白、先锋字体排印",
  "engine": "jinja2",
  "templateEngine": "jinja2",
  "customConfig": [
    {
      "name": "accentColor",
      "label": "强调色",
      "group": "外观设置",
      "type": "input",
      "value": "#00d2ff",
      "note": "链接、装饰等元素的强调颜色"
    },
    {
      "name": "showDarkModeToggle",
      "label": "显示暗色模式切换",
      "group": "外观设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "showSidebar",
      "label": "显示侧边栏",
      "group": "布局设置",
      "type": "toggle",
      "value": false
    },
    {
      "name": "postsPerPage",
      "label": "每页文章数",
      "group": "文章设置",
      "type": "input",
      "value": "10"
    },
    {
      "name": "showTagsInPost",
      "label": "文章底部显示标签",
      "group": "文章设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "showPostNav",
      "label": "显示上下篇导航",
      "group": "文章设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "socialGithub",
      "label": "GitHub 用户名",
      "group": "社交设置",
      "type": "input",
      "value": ""
    },
    {
      "name": "socialTwitter",
      "label": "Twitter 用户名",
      "group": "社交设置",
      "type": "input",
      "value": ""
    },
    {
      "name": "footerText",
      "label": "页脚自定义文字",
      "group": "基础设置",
      "type": "input",
      "value": ""
    },
    {
      "name": "customCSS",
      "label": "自定义 CSS",
      "group": "高级设置",
      "type": "textarea",
      "value": ""
    }
  ]
}
