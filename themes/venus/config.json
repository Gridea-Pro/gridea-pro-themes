{
  "name": "Venus",
  "version": "1.0.0",
  "author": "seolcho0827",
  "description": "温暖优雅的视觉系博客主题 · 暖色调、大图展示、杂志风排版",
  "templateEngine": "jinja2",
  "customConfig": [
    {
      "name": "accentColor",
      "label": "强调色",
      "group": "外观设置",
      "type": "input",
      "value": "#c73e3e",
      "note": "链接、按钮等元素的强调颜色"
    },
    {
      "name": "showDarkModeToggle",
      "label": "显示暗色模式切换",
      "group": "外观设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "showHero",
      "label": "显示 Hero 大图区域",
      "group": "首页设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "heroTitle",
      "label": "Hero 标题",
      "group": "首页设置",
      "type": "input",
      "value": ""
    },
    {
      "name": "heroSubtitle",
      "label": "Hero 副标题",
      "group": "首页设置",
      "type": "input",
      "value": ""
    },
    {
      "name": "heroImage",
      "label": "Hero 背景图",
      "group": "首页设置",
      "type": "picture-upload",
      "value": ""
    },
    {
      "name": "showFeaturedPosts",
      "label": "显示推荐文章区域",
      "group": "首页设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "showSearch",
      "label": "顶栏显示搜索框",
      "group": "功能设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "sidebarPosition",
      "label": "侧边栏位置",
      "group": "布局设置",
      "type": "select",
      "value": "left",
      "options": [
        { "label": "左侧", "value": "left" },
        { "label": "右侧", "value": "right" }
      ]
    },
    {
      "name": "showSidebar",
      "label": "显示侧边栏",
      "group": "布局设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "postsPerPage",
      "label": "每页文章数",
      "group": "文章设置",
      "type": "input",
      "value": "10"
    },
    {
      "name": "showTagsInPost",
      "label": "文章底部显示标签",
      "group": "文章设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "showPostNav",
      "label": "显示上下篇导航",
      "group": "文章设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "socialGithub",
      "label": "GitHub 用户名",
      "group": "社交设置",
      "type": "input",
      "value": ""
    },
    {
      "name": "socialTwitter",
      "label": "Twitter 用户名",
      "group": "社交设置",
      "type": "input",
      "value": ""
    },
    {
      "name": "footerText",
      "label": "页脚自定义文字",
      "group": "基础设置",
      "type": "input",
      "value": ""
    },
    {
      "name": "customCSS",
      "label": "自定义 CSS",
      "group": "高级设置",
      "type": "textarea",
      "value": ""
    }
  ]
}
